                            <tr><th>Naklada</th><td>1000 kosov</td></tr>
                        </table>

                        <h2>Specifikacija stroškov</h2>
                        <table>
                            <tr><th>Strošek papirja</th><td>0.00 €</td></tr>
                            <tr><th>Priprava & Plošče</th><td>0.00 €</td></tr>
                            <tr><th>Tisk</th><td>0.00 €</td></tr>
                            <tr><th>Dodelava</th><td>0.00 €</td></tr>
                            <tr class="total"><th>Skupaj (brez DDV)</th><td>0.00 €</td></tr>
