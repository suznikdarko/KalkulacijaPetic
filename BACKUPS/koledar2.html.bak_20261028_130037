        // --- ZANESLJIV PDF PREGLEDOVALNIK (IZVIRNI BRSKALNIŠKI PREDOGLED + STRANSKI DELJENI POGLED) ---
        var g_pdfViewerMode = 'native'; // 'native' (izvirni originalni PDF z označevanjem/kopiranjem) ali 'canvas'
        var g_pdfViewerLayout = 'side'; // 'side' (stransko okno ob kalkulaciji) ali 'full' (celozaslonski)
