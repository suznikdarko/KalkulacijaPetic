        async function handlePdfFileUpload(event) {
            const files = event.target.files ? Array.from(event.target.files) : [];
            if (files.length === 0) return;
            
            let lastParsedDoc = null;
            let addedCount = 0;

            for (const file of files) {
                try {
                    const arrayBuffer = await file.arrayBuffer();
                    const dataUrl = await new Promise((resolve) => {
                        const r = new FileReader();
                        r.onload = e => resolve(e.target.result);
                        r.readAsDataURL(file);
                    });

                    let fullText = "";
                    let detectedWidthMm = null;
                    let detectedHeightMm = null;
                    let numPages = 0;
                    const lname = file.name.toLowerCase();
                    const isPdf = lname.endsWith('.pdf');
                    const isExcel = lname.endsWith('.xlsx') || lname.endsWith('.xls');
                    const isWord = lname.endsWith('.docx') || lname.endsWith('.doc');
                    const isImage = lname.endsWith('.jpg') || lname.endsWith('.jpeg') || lname.endsWith('.png') || lname.endsWith('.webp');

                    if (isPdf && typeof pdfjsLib !== 'undefined') {
                        try {
                            const loadingTask = pdfjsLib.getDocument({ data: arrayBuffer.slice(0) });
                            const pdf = await loadingTask.promise;
                            numPages = pdf.numPages;
                            for (let pageNum = 1; pageNum <= pdf.numPages; pageNum++) {
                                const page = await pdf.getPage(pageNum);
                                const textContent = await page.getTextContent();
                                const pageStr = textContent.items.map(item => item.str).join(" ");
                                fullText += pageStr + "\n";
                                if (pageNum === 1) {
                                    const vp = page.getViewport({ scale: 1.0 });
                                    detectedWidthMm = Math.round(vp.width * 25.4 / 72);
                                    detectedHeightMm = Math.round(vp.height * 25.4 / 72);
                                }
                            }
                        } catch (eText) {
                            console.warn("PDF text extraction warning:", eText);
                        }
                    } else if (isExcel && typeof XLSX !== 'undefined') {
                        try {
                            const wb = XLSX.read(new Uint8Array(arrayBuffer), { type: 'array' });
                            wb.SheetNames.forEach(sName => {
                                const ws = wb.Sheets[sName];
                                const txt = XLSX.utils.sheet_to_txt(ws);
                                fullText += `[List: ${sName}]\n` + txt + "\n\n";
                            });
                        } catch(eXls) {
                            console.warn("Excel extraction warning:", eXls);
                        }
                    } else if (isImage) {
                        try {
                            const img = new Image();
                            img.src = dataUrl;
                            await new Promise(r => { img.onload = r; img.onerror = r; });
                            detectedWidthMm = img.naturalWidth;
                            detectedHeightMm = img.naturalHeight;
                        } catch(eImg) {}
                    }

                    const fileType = isPdf ? 'pdf' : (isExcel ? 'excel' : (isWord ? 'word' : (isImage ? 'image' : 'other')));
                    const docObj = {
                        name: file.name,
                        dataUrl: dataUrl,
                        arrayBuffer: arrayBuffer,
                        text: fullText,
                        fileType: fileType,
                        widthMm: detectedWidthMm,
                        heightMm: detectedHeightMm,
                        numPages: numPages,
                        timestamp: Date.now()
                    };

                    const existingIdx = g_attachedPdfs.findIndex(p => p.name === file.name);
                    if (existingIdx >= 0) {
                        g_attachedPdfs[existingIdx] = docObj;
                        g_currentPdfIndex = existingIdx;
                    } else {
                        g_attachedPdfs.push(docObj);
                        g_currentPdfIndex = g_attachedPdfs.length - 1;
                    }
                    syncActiveAttachedPdf();
                    lastParsedDoc = docObj;
                    addedCount++;
                } catch (err) {
                    console.error("Napaka pri branju datoteke " + file.name + ":", err);
                    alert("Napaka pri branju datoteke " + file.name + ": " + err.message);
                }
            }

            event.target.value = '';
            updatePdfBadge();

            if (lastParsedDoc) {
                const lname = (lastParsedDoc.name || '').toLowerCase();
                if (lname.endsWith('.pdf') && typeof parsePdfAndShowDataModal === 'function') {
                    parsePdfAndShowDataModal(lastParsedDoc.text, lastParsedDoc.name, lastParsedDoc.widthMm, lastParsedDoc.heightMm);
                }
            }
        }

