                document.body.appendChild(modal);
            }

            const fname = target.name || 'Dokument';
            const lname = fname.toLowerCase();
            const isExcel = lname.endsWith('.xlsx') || lname.endsWith('.xls');
            const isWord = lname.endsWith('.docx') || lname.endsWith('.doc');
            const isImage = lname.endsWith('.jpg') || lname.endsWith('.jpeg') || lname.endsWith('.png') || lname.endsWith('.webp');

            document.getElementById('doc-preview-icon').textContent = isImage ? '🖼️' : (isExcel ? '📊' : (isWord ? '📝' : '📄'));
            document.getElementById('doc-preview-title').textContent = fname;
            document.getElementById('doc-preview-dl-btn').onclick = () => downloadAttachedPdf(index);

            const sheetsBar = document.getElementById('doc-preview-sheets-bar');
            const bodyEl = document.getElementById('doc-preview-body');
            sheetsBar.innerHTML = '';
            bodyEl.innerHTML = '';

            if (isImage) {
                sheetsBar.style.display = 'none';
                const imgSrc = target.dataUrl || (target.arrayBuffer ? URL.createObjectURL(new Blob([target.arrayBuffer], { type: (lname.endsWith('.png') ? 'image/png' : 'image/jpeg') })) : '');
                const dims = (target.widthMm && target.heightMm) ? ` (${target.widthMm} × ${target.heightMm} px)` : '';
                bodyEl.innerHTML = `
                    <div style="display:flex; flex-direction:column; align-items:center; justify-content:center; height:100%; min-height:450px; padding:10px;">
                        <img src="${imgSrc}" style="max-width:100%; max-height:72vh; object-fit:contain; border-radius:8px; box-shadow:0 10px 25px rgba(0,0,0,0.5); border:1px solid #334155;" alt="${fname}">
                        <div style="margin-top:12px; font-size:0.8rem; color:#94a3b8; font-weight:600;">🖼️ ${fname}${dims}</div>
                    </div>
                `;
            } else if (isExcel && typeof XLSX !== 'undefined') {
                try {
                    let wb = null;
                    if (target.arrayBuffer) {
                        wb = XLSX.read(new Uint8Array(target.arrayBuffer), { type: 'array' });
                    } else if (target.dataUrl) {
                        const b64 = target.dataUrl.indexOf(',') >= 0 ? target.dataUrl.split(',')[1] : target.dataUrl;
                        wb = XLSX.read(b64, { type: 'base64' });
                    }

                    if (wb && wb.SheetNames && wb.SheetNames.length > 0) {
                        sheetsBar.style.display = wb.SheetNames.length > 1 ? 'flex' : 'none';
                        
                        function renderSheet(sheetName) {
                            const ws = wb.Sheets[sheetName];
                            if (!ws) return;
                            const htmlTable = XLSX.utils.sheet_to_html(ws, { id: 'preview-table', editable: false });
                            bodyEl.innerHTML = `
                                <style>
                                    #preview-table { border-collapse: collapse; width: 100%; font-size: 0.82rem; }
                                    #preview-table th, #preview-table td { border: 1px solid #334155; padding: 6px 10px; }
                                    #preview-table tr:first-child td { background: #1e293b; color: #38bdf8; font-weight: bold; position: sticky; top: 0; }
                                    #preview-table tr:nth-child(even) { background: rgba(255, 255, 255, 0.02); }
                                    #preview-table tr:hover { background: rgba(59, 130, 246, 0.1); }
                                </style>
                                ${htmlTable}
                            `;
                        }

                        wb.SheetNames.forEach((sName, sIdx) => {
                            const btn = document.createElement('button');
                            btn.type = 'button';
                            btn.textContent = sName;
                            btn.style.cssText = (sIdx === 0) ? 'background:#059669; color:white; border:none; border-radius:4px; padding:4px 10px; font-size:0.75rem; font-weight:bold; cursor:pointer;' : 'background:#334155; color:#cbd5e1; border:none; border-radius:4px; padding:4px 10px; font-size:0.75rem; cursor:pointer;';
                            btn.onclick = () => {
                                Array.from(sheetsBar.children).forEach(c => {
                                    c.style.background = '#334155';
                                    c.style.color = '#cbd5e1';
                                });
                                btn.style.background = '#059669';
                                btn.style.color = 'white';
                                renderSheet(sName);
                            };
                            sheetsBar.appendChild(btn);
                        });

                        renderSheet(wb.SheetNames[0]);
                    } else {
                        bodyEl.innerHTML = '<div style="padding:20px; text-align:center; color:#94a3b8;">Ni najdenih delovnih listov v tem zvezku.</div>';
                    }
                } catch(e) {
                    bodyEl.innerHTML = `<div style="padding:20px; color:#f87171;">Napaka pri branju Excel datoteke: ${e.message}</div>`;
                }
            } else if (target.text) {
                sheetsBar.style.display = 'none';
                bodyEl.innerHTML = `<pre style="white-space: pre-wrap; font-family: monospace; font-size: 0.85rem; color: #cbd5e1; line-height: 1.5;">${target.text}</pre>`;
            } else {
                sheetsBar.style.display = 'none';
                bodyEl.innerHTML = `
                    <div style="padding:40px; text-align:center;">
                        <div style="font-size:2rem; margin-bottom:10px;">📄</div>
                        <div style="font-weight:bold; font-size:1.1rem; margin-bottom:8px;">${fname}</div>
                        <p style="color:#94a3b8; font-size:0.85rem; margin-bottom:16px;">Za ogled ali urejanje te datoteke kliknite spodnji gumb za prenos.</p>
                        <button type="button" onclick="downloadAttachedPdf(${index})" style="background:#0284c7; color:white; border:none; border-radius:6px; padding:8px 18px; font-size:0.9rem; font-weight:bold; cursor:pointer;">💾 Prenesi in odpri v računalniku</button>
                    </div>
                `;
            }

            modal.style.display = 'flex';
        }

        if (!window._pasteImageListenerAttached) {
            window._pasteImageListenerAttached = true;
            window.addEventListener('paste', function(e) {
                const activeTag = (document.activeElement && document.activeElement.tagName) ? document.activeElement.tagName.toLowerCase() : '';
                if (activeTag === 'input' || activeTag === 'textarea') return;
                const items = (e.clipboardData || e.originalEvent?.clipboardData)?.items;
                if (!items) return;
                for (let i = 0; i < items.length; i++) {
                    if (items[i].type && items[i].type.indexOf('image') !== -1) {
                        const blob = items[i].getAsFile();
                        if (blob) {
                            const now = new Date();
                            const timeStr = now.getFullYear() + '-' + String(now.getMonth()+1).padStart(2, '0') + '-' + String(now.getDate()).padStart(2, '0') + '_' + String(now.getHours()).padStart(2, '0') + String(now.getMinutes()).padStart(2, '0') + String(now.getSeconds()).padStart(2, '0');
                            const ext = blob.type.includes('png') ? '.png' : '.jpg';
                            const fakeFile = new File([blob], 'slika_' + timeStr + ext, { type: blob.type });
                            handlePdfFileUpload({ target: { files: [fakeFile] } });
                            break;
                        }
                    }
                }
            });
        }
        
