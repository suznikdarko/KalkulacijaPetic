        function setPdfViewerMode(mode) {
            g_pdfViewerMode = mode || 'native';
            const canvasContainer = document.getElementById('pdf-viewer-canvas-mode');
            const iframeContainer = document.getElementById('pdf-viewer-iframe-mode');
            const btnCanvas = document.getElementById('btn-mode-canvas');
            const btnNative = document.getElementById('btn-mode-native');
            const zoomToolbar = document.getElementById('pdf-zoom-toolbar');
            const nativeTip = document.getElementById('pdf-native-tip');

            if (g_pdfViewerMode === 'native') {
                if (canvasContainer) canvasContainer.style.display = 'none';
                if (iframeContainer) iframeContainer.style.display = 'flex';
                if (zoomToolbar) zoomToolbar.style.display = 'none';
                if (nativeTip) nativeTip.style.display = 'flex';
                if (btnCanvas) {
                    btnCanvas.style.background = 'transparent';
                    btnCanvas.style.color = '#94a3b8';
                }
                if (btnNative) {
                    btnNative.style.background = '#2563eb';
                    btnNative.style.color = 'white';
                }
                renderPdfNativeIframe();
            } else {
                if (canvasContainer) canvasContainer.style.display = 'flex';
                if (iframeContainer) iframeContainer.style.display = 'none';
                if (zoomToolbar) zoomToolbar.style.display = 'flex';
                if (nativeTip) nativeTip.style.display = 'none';
                if (btnCanvas) {
                    btnCanvas.style.background = '#2563eb';
                    btnCanvas.style.color = 'white';
                }
                if (btnNative) {
                    btnNative.style.background = 'transparent';
                    btnNative.style.color = '#94a3b8';
