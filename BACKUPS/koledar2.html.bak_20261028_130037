                const qtyVal = parseFloat(valStr.replace(/\./g, '').replace(',', '.'));
                if (!isNaN(qtyVal) && qtyVal > 0) {
                    const inpQty = document.getElementById('quantity') || document.getElementById('inp-quantity') || document.getElementById('calc-qty') || document.getElementById('proj-quantities');
