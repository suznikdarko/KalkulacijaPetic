        function autoParseEmailHeaders(text) {
            if (!text) return;
            const subjMatch = text.match(/(?:Subject|Zadeva|Predmet):\s*(.+)/i);
            if (subjMatch && subjMatch[1]) {
                const subjEl = document.getElementById('calc-email-subject');
                if (subjEl && !subjEl.value) subjEl.value = subjMatch[1].trim();
            }
            const fromMatch = text.match(/(?:From|Od|Pošiljatelj|Posiljatelj):\s*(.+)/i);
            if (fromMatch && fromMatch[1]) {
                const fromEl = document.getElementById('calc-email-sender');
                if (fromEl && !fromEl.value) fromEl.value = fromMatch[1].trim();
            }
            const dateMatch = text.match(/(?:Date|Datum):\s*(.+)/i);
            if (dateMatch && dateMatch[1]) {
                const dateEl = document.getElementById('calc-email-date');
                if (dateEl && !dateEl.value) dateEl.value = dateMatch[1].trim();
            }
        }

        function extractDataFromEmail() {
            const text = document.getElementById('calc-email-content')?.value || '';
            if (!text.trim()) {
                alert('Najprej prilepite ali vnesite besedilo e-pošte!');
                return;
            }

            let extracted = [];

            // 1. Stranka / Pošiljatelj
            const fromEl = document.getElementById('calc-email-sender')?.value || '';
            const custInput = document.getElementById('calc-customer');
            if (fromEl && custInput && !custInput.value) {
                let cleanCust = fromEl.replace(/<.*?>/, '').trim();
                extracted.push(`• Stranka: ${cleanCust}`);
            }

            // 2. Količina / Naklada
            const qtyMatch = text.match(/(?:naklada|količina|kolicina|kosov|kom|kol|qty|kosa|kos)[\s:]*([0-9\.\s]+)/i);
            let parsedQty = null;
            if (qtyMatch && qtyMatch[1]) {
                let q = qtyMatch[1].replace(/\./g, '').replace(/\s/g, '');
                if (parseInt(q) > 0) {
                    parsedQty = parseInt(q);
                    extracted.push(`• Količina: ${parsedQty.toLocaleString('de-DE')} kos`);
                }
            }

            // 3. Format / Dimenzije
            const dimMatch = text.match(/([0-9]+(?:[\.,][0-9]+)?)\s*[xX*×]\s*([0-9]+(?:[\.,][0-9]+)?)\s*(?:mm|cm)?/);
            let parsedW = null, parsedH = null;
            if (dimMatch && dimMatch[1] && dimMatch[2]) {
                parsedW = parseFloat(dimMatch[1].replace(',', '.'));
                parsedH = parseFloat(dimMatch[2].replace(',', '.'));
                if (parsedW > 0 && parsedH > 0) {
                    extracted.push(`• Format: ${parsedW} x ${parsedH} mm`);
                }
            }

            // 4. Število listov
            const sheetsMatch = text.match(/([0-9]+)\s*(?:listov|listni|stranski|list)/i);
            let parsedSheets = null;
            if (sheetsMatch && sheetsMatch[1]) {
                parsedSheets = parseInt(sheetsMatch[1]);
                if (parsedSheets > 0) {
                    extracted.push(`• Število listov: ${parsedSheets}`);
                }
            }

            if (extracted.length === 0) {
                if (confirm('Sistem ni zaznal točnih številčnih parametrov. Ali želite besedilo maila dodati v polje "Pripombe / posebnosti"?')) {
                    const notesEl = document.getElementById('calc-notes');
                    if (notesEl) {
                        notesEl.value = (notesEl.value ? notesEl.value + '\n\n' : '') + text;
                    }
                }
                return;
            }

            const msg = "Zaznani podatki iz sporočila:\n\n" + extracted.join('\n') + "\n\nAli želite te podatke samodejno prenesti v polja kalkulacije in pripombe?";
            if (confirm(msg)) {
                if (fromEl && custInput && !custInput.value) {
                    custInput.value = fromEl.replace(/<.*?>/, '').trim();
                }
                if (parsedQty) {
                    const qtyInput = document.getElementById('proj-quantities');
                    if (qtyInput) qtyInput.value = parsedQty;
                }
                if (parsedW && parsedH) {
                    const wInput = document.getElementById('cal-width');
                    const hInput = document.getElementById('cal-height');
                    if (wInput && hInput) {
                        wInput.value = parsedW;
                        hInput.value = parsedH;
                    }
                }
                if (parsedSheets) {
                    const sInput = document.getElementById('cal-sheets');
                    if (sInput) sInput.value = parsedSheets;
                }
                const notesEl = document.getElementById('calc-notes');
                if (notesEl && !notesEl.value.trim()) {
                    notesEl.value = "Povpraševanje:\n" + text.substring(0, 300) + (text.length > 300 ? '...' : '');
                }
                if (typeof calculate === 'function') calculate();
                alert('Podatki uspešno preneseni v kalkulacijo!');
            }
        }

