            <!-- PREKLOP STRANSKI / POLNI POGLED + HITRE ŠIRINE -->
            <div style="display:flex; align-items:center; gap:4px; background:#0f172a; padding:3px 6px; border-radius:8px; border:1px solid #334155;">
                <button type="button" id="btn-layout-side" onclick="setPdfViewerLayout('side')" title="Stranski pogled ob kalkulaciji (kalkulacija ostane vidna na levi)" style="background:#2563eb; color:white; border:none; border-radius:5px; padding:4px 8px; font-size:0.75rem; font-weight:700; cursor:pointer; display:flex; align-items:center; gap:4px;">🌓 Ob kalkulaciji</button>
                <div id="pdf-width-presets" style="display:flex; gap:2px;">
                    <button type="button" onclick="setPdfViewerLayout('side', '40%')" title="Širina 40%" style="background:#1e293b; color:#94a3b8; border:none; border-radius:4px; padding:3px 6px; font-size:0.7rem; font-weight:600; cursor:pointer;">40%</button>
                    <button type="button" onclick="setPdfViewerLayout('side', '52%')" title="Širina 50%" style="background:#1e293b; color:#94a3b8; border:none; border-radius:4px; padding:3px 6px; font-size:0.7rem; font-weight:600; cursor:pointer;">50%</button>
                    <button type="button" onclick="setPdfViewerLayout('side', '65%')" title="Širina 65%" style="background:#1e293b; color:#94a3b8; border:none; border-radius:4px; padding:3px 6px; font-size:0.7rem; font-weight:600; cursor:pointer;">65%</button>
                </div>
                <button type="button" id="btn-layout-full" onclick="setPdfViewerLayout('full')" title="Celozaslonski pogled (100% širina)" style="background:transparent; color:#94a3b8; border:none; border-radius:5px; padding:4px 8px; font-size:0.75rem; font-weight:600; cursor:pointer; display:flex; align-items:center; gap:4px;">⬛ Cel zaslon</button>
            </div>

            <!-- GUMBI ZA AKCIJE -->
            <div style="display:flex; align-items:center; gap:6px;">
                <button type="button" onclick="openPdfInNewTab()" title="Odpri izvirni PDF v novem zavihku brskalnika ali na drugem zaslonu" style="background:#4f46e5; color:white; border:none; border-radius:6px; padding:5px 10px; font-size:0.78rem; font-weight:bold; cursor:pointer; display:flex; align-items:center; gap:4px;">↗ V novem zavihku</button>
                <button type="button" onclick="reopenPdfDataModal()" title="Ponovno preveri in samodejno prenesi polja iz PDF v kalkulacijo" style="background:linear-gradient(135deg, #8b5cf6, #7c3aed); color:white; border:none; border-radius:6px; padding:5px 10px; font-size:0.78rem; font-weight:bold; cursor:pointer; display:flex; align-items:center; gap:4px;">⚡ Samodejni prenos</button>
                <button type="button" onclick="downloadAttachedPdf()" title="Prenesi izvirno PDF datoteko" style="background:#0284c7; color:white; border:none; border-radius:6px; padding:5px 8px; font-size:0.78rem; font-weight:bold; cursor:pointer;">💾</button>
                <button type="button" onclick="closePdfViewerModal()" title="Zapri stransko okno (Esc)" style="background:#ef4444; color:white; border:none; border-radius:6px; padding:5px 12px; font-size:0.8rem; font-weight:bold; cursor:pointer;">✕</button>
            </div>
        </div>

        <!-- OPOZORILO / NAVODILO ZA KOPIRANJE V PONUDBO -->
        <div id="pdf-native-tip" style="background:rgba(30, 41, 59, 0.95); border-bottom:1px solid #334155; padding:6px 14px; font-size:0.78rem; color:#cbd5e1; display:flex; align-items:center; justify-content:space-between; gap:10px;">
            <span style="display:flex; align-items:center; gap:6px;">
                <span style="color:#38bdf8; font-weight:bold;">💡 KOPIRANJE V PONUDBO:</span> 
                V dokumentu spodaj z miško označite želeno besedilo in pritisnite <kbd style="background:#0f172a; padding:1px 6px; border-radius:4px; border:1px solid #475569; font-weight:bold; color:#60a5fa;">Ctrl + C</kbd>, nato ga prilepite (<kbd style="background:#0f172a; padding:1px 6px; border-radius:4px; border:1px solid #475569; font-weight:bold; color:#60a5fa;">Ctrl + V</kbd>) v polje kalkulacije na levi.
            </span>
            <span style="font-size:0.73rem; color:#94a3b8; font-weight:600;">100% izvirni PDF brez popačenj</span>
        </div>

        <!-- VGRAJENI BRSKALNIŠKI IFRAME NAČIN POGLEDA (GLAVNI IN PRIVZETI) -->
        <div id="pdf-viewer-iframe-mode" style="flex:1; width:100%; height:100%; display:flex; flex-direction:column; background:#0b1120;">
            <iframe id="pdf-viewer-native-frame" src="about:blank" style="width:100%; height:100%; border:none; background:#1e293b;" title="Vgrajeni PDF pregledovalnik"></iframe>
        </div>

        <!-- CANVAS NAČIN POGLEDA (REZERVNI) -->
        <div id="pdf-viewer-canvas-mode" style="flex:1; width:100%; height:100%; display:none; flex-direction:column; overflow:hidden;">
            <div id="pdf-viewer-scroll-container" style="flex:1; background:#0b1120; overflow:auto; display:flex; flex-direction:column; align-items:center; gap:20px; padding:24px; position:relative;">
                <div id="pdf-viewer-loading" style="display:none; color:#cbd5e1; font-size:1rem; margin-top:60px; background:#1e293b; padding:16px 28px; border-radius:12px; border:1px solid #334155; box-shadow:0 10px 25px rgba(0,0,0,0.5); font-family:sans-serif;">
                    ⏳ Nalaganje in izrisovanje PDF dokumenta...
                </div>
            </div>
        </div>
    </div>

    <!-- MODAL ZA E-POŠTO STRANKE -->
    <div id="email-modal-overlay" style="display: none; position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px); z-index: 99999; justify-content: center; align-items: center;">
        <div style="background: #1e293b; border: 1px solid #3b82f6; border-radius: 12px; width: 850px; max-width: 95vw; max-height: 90vh; display: flex; flex-direction: column; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7); overflow: hidden; font-family: 'Inter', sans-serif;">
            
            <!-- MODAL HEADER -->
            <div style="padding: 14px 20px; background: #0f172a; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center;">
                <div style="display: flex; align-items: center; gap: 10px;">
                    <span style="font-size: 1.25rem;">✉️</span>
                    <div>
                        <h3 style="margin: 0; color: #f8fafc; font-size: 1.05rem; font-weight: 700;">E-pošta / Povpraševanje stranke</h3>
                        <p style="margin: 0; color: #94a3b8; font-size: 0.75rem;">Prilepite sporočilo ali uvozite datoteko – shrani se neposredno v kalkulacijo</p>
                    </div>
                </div>
                <button type="button" onclick="closeEmailModal()" style="background: none; border: none; color: #94a3b8; font-size: 1.25rem; cursor: pointer; padding: 4px 8px; border-radius: 6px;" title="Zapri (Esc)">✕</button>
            </div>

            <!-- MODAL TOOLBAR -->
            <div style="padding: 10px 20px; background: #1e293b; border-bottom: 1px solid #334155; display: flex; gap: 8px; flex-wrap: wrap; align-items: center;">
                <button type="button" onclick="pasteEmailFromClipboard()" style="background: #2563eb; color: white; border: none; border-radius: 6px; padding: 6px 12px; font-size: 0.8rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;" title="Prilepi iz odložišča">
                    📋 Prilepi iz odložišča
                </button>
                <button type="button" onclick="document.getElementById('email-file-input').click()" style="background: #334155; color: #f8fafc; border: 1px solid #475569; border-radius: 6px; padding: 6px 12px; font-size: 0.8rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;" title="Uvozi datoteko sporočila">
                    📂 Uvozi datoteko (.eml, .txt, .msg)
                </button>
                <input type="file" id="email-file-input" accept=".eml,.txt,.msg,.log" style="display:none;" onchange="handleEmailFileSelect(event)">
                <button type="button" onclick="extractDataFromEmail()" style="background: #8b5cf6; color: white; border: none; border-radius: 6px; padding: 6px 12px; font-size: 0.8rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;" title="Poskusi samodejno izluščiti podatke o stranki, nakladi, formatu...">
                    ⚡ Izlušči podatke v kalkulacijo
                </button>
                <button type="button" onclick="clearEmailForm()" style="background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid #ef4444; border-radius: 6px; padding: 6px 10px; font-size: 0.8rem; cursor: pointer;" title="Počisti vsa polja e-pošte">
                    🧹 Počisti
                </button>
            </div>

            <!-- MODAL CONTENT / FORM -->
            <div style="padding: 16px 20px; overflow-y: auto; flex: 1; display: flex; flex-direction: column; gap: 12px;">
                
                <!-- METADATA ROW -->
                <div style="display: grid; grid-template-columns: 2fr 1fr 1fr; gap: 10px;">
                    <div>
                        <label for="calc-email-subject" style="display: block; font-size: 0.75rem; color: #94a3b8; font-weight: 600; margin-bottom: 4px;">Zadeva (Subject):</label>
                        <input type="text" id="calc-email-subject" placeholder="Npr. Povpraševanje za koledarje..." style="width: 100%; box-sizing: border-box; background: #0f172a; border: 1px solid #334155; border-radius: 6px; color: #f8fafc; padding: 6px 10px; font-size: 0.85rem;" oninput="onEmailFieldChanged()">
                    </div>
                    <div>
                        <label for="calc-email-sender" style="display: block; font-size: 0.75rem; color: #94a3b8; font-weight: 600; margin-bottom: 4px;">Pošiljatelj / Email:</label>
                        <input type="text" id="calc-email-sender" placeholder="ime@stranka.si" style="width: 100%; box-sizing: border-box; background: #0f172a; border: 1px solid #334155; border-radius: 6px; color: #f8fafc; padding: 6px 10px; font-size: 0.85rem;" oninput="onEmailFieldChanged()">
                    </div>
                    <div>
                        <label for="calc-email-date" style="display: block; font-size: 0.75rem; color: #94a3b8; font-weight: 600; margin-bottom: 4px;">Datum maila:</label>
                        <input type="text" id="calc-email-date" placeholder="07. 10. 2026" style="width: 100%; box-sizing: border-box; background: #0f172a; border: 1px solid #334155; border-radius: 6px; color: #f8fafc; padding: 6px 10px; font-size: 0.85rem;" oninput="onEmailFieldChanged()">
                    </div>
                </div>

                <!-- EMAIL BODY TEXTAREA / DROP ZONE -->
                <div style="flex: 1; display: flex; flex-direction: column;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 4px;">
                        <label for="calc-email-content" style="font-size: 0.75rem; color: #94a3b8; font-weight: 600;">Vsebina e-pošte / sporočila:</label>
                        <span id="email-char-count" style="font-size: 0.72rem; color: #64748b;">0 znakov</span>
                    </div>
                    <textarea id="calc-email-content" placeholder="Prilepite celotno sporočilo (Ctrl+V) ali povlecite .eml / .txt datoteko sem..." rows="12"
                        style="width: 100%; box-sizing: border-box; flex: 1; min-height: 250px; background: #0f172a; border: 1.5px dashed #475569; border-radius: 8px; color: #e2e8f0; padding: 12px; font-family: 'Segoe UI', Inter, sans-serif; font-size: 0.85rem; line-height: 1.5; resize: vertical;"
                        oninput="onEmailFieldChanged()"
                        ondragover="event.preventDefault(); this.style.borderColor='#3b82f6'; this.style.background='#1e293b';"
                        ondragleave="this.style.borderColor='#475569'; this.style.background='#0f172a';"
                        ondrop="handleEmailDrop(event)"></textarea>
                </div>
            </div>

            <!-- MODAL FOOTER -->
            <div style="padding: 12px 20px; background: #0f172a; border-top: 1px solid #334155; display: flex; justify-content: space-between; align-items: center;">
                <div id="email-modal-status" style="font-size: 0.8rem; color: #10b981; font-weight: 600;"></div>
                <div style="display: flex; gap: 8px;">
                    <button type="button" onclick="closeEmailModal()" style="background: #334155; color: #e2e8f0; border: none; border-radius: 6px; padding: 8px 16px; font-size: 0.85rem; font-weight: 600; cursor: pointer;">
                        Zapri
                    </button>
                    <button type="button" onclick="saveEmailModalData()" style="background: linear-gradient(135deg, #0284c7, #2563eb); color: white; border: none; border-radius: 6px; padding: 8px 18px; font-size: 0.85rem; font-weight: 700; cursor: pointer; box-shadow: 0 4px 12px rgba(2,132,199,0.3);">
                        💾 Shrani v kalkulacijo
                    </button>
                </div>
            </div>

        </div>
    </div>
</body>
</html>
