                if (!indexData) {
                    indexData = await loadFolderIndex();
                }

                if (indexData && Array.isArray(indexData.projects)) {
                    g_diskProjectsMetadata = {};
                    g_diskProjects = [];
                    indexData.projects.forEach(p => {
