        function calculate() {
            const rawQuantitiesStr = (document.getElementById('proj-quantities') ? document.getElementById('proj-quantities').value.trim() : '');
            const quantities = rawQuantitiesStr.split(',').map(q => parseInt(q.trim())).filter(q => !isNaN(q) && q > 0);
            const marginStr = document.getElementById('proj-margin') ? document.getElementById('proj-margin').value.trim() : '';
            const margin = marginStr !== '' ? (parseFloat(marginStr) || 0) : 0;
            const ddvPercent = 22;

            // Calendar specs
            const numSheets = parseInt(document.getElementById('cal-sheets').value) || 13;
            const sheetsPerForm = parseInt(document.getElementById('cal-sheets-per-form').value) || 1;
            const calWidth = parseFloat(document.getElementById('cal-width').value) || 297;
            const calHeight = parseFloat(document.getElementById('cal-height').value) || 420;
            const colorsFrontLeaves = parseInt(document.getElementById('cal-colors-front') ? document.getElementById('cal-colors-front').value : 4) || 0;
            const colorsBackLeaves = parseInt(document.getElementById('cal-colors-back') ? document.getElementById('cal-colors-back').value : 0) || 0;
            const printType = `${colorsFrontLeaves}/${colorsBackLeaves}`;

            const podkartonColorsFront = parseInt(document.getElementById('podkarton-colors-front') ? document.getElementById('podkarton-colors-front').value : 0) || 0;
            const podkartonColorsBack = parseInt(document.getElementById('podkarton-colors-back') ? document.getElementById('podkarton-colors-back').value : 0) || 0;
            const totalPodkartonColors = podkartonColorsFront + podkartonColorsBack;

            // Paper specs
            const paperWeight = parseFloat(document.getElementById('paper-weight').value) || 170;
            const paperPriceKg = parseFloat(document.getElementById('paper-price-kg').value) || 1.45;
            const wastePercent = parseFloat(document.getElementById('paper-waste-percent').value) || 8;
            const sheetFormat = document.getElementById('sheet-format').value;

            // Machine specs matching pola2.html
            const printTech = document.getElementById('print-tech').value;
            const platePrice = parseFloat(document.getElementById('plate-price').value) || 10.0;
            const setupCostPerForm = parseFloat(document.getElementById('setup-cost-per-form').value) || 25.0;

            // Podkarton specs
            const podkartonType = document.getElementById('podkarton-type').value;
            const podkartonMaterial = document.getElementById('podkarton-material').value;
            const podkartonPriceKg = parseFloat(document.getElementById('podkarton-price-kg').value) || 1.60;
            const podkartonCutPrice = parseFloat(document.getElementById('podkarton-cut-price').value) || 0.04;
            const podkartonKasiranjePrice = parseFloat(document.getElementById('podkarton-kasiranje-price').value) || 0.05;

            // Finishing & Manual
            const znasanjePerSheet = parseFloat(document.getElementById('znasanje-price-per-sheet').value) || 0.008;
            const spiralaPriceBase = parseFloat(document.getElementById('spirala-price-base').value) || 0.28;
            const hasVesalcek = document.getElementById('has-vesalcek').value === 'da';
            const vesalcekPrice = hasVesalcek ? (parseFloat(document.getElementById('vesalcek-price').value) || 0.06) : 0;
            const hasVezica = document.getElementById('has-vezica').value === 'da';
            const vezicaPrice = hasVezica ? (parseFloat(document.getElementById('vezica-price').value) || 0.15) : 0;
            const manualLaborPrice = parseFloat(document.getElementById('manual-labor-price').value) || 0.05;
            const packagingPrice = parseFloat(document.getElementById('packaging-price').value) || 0.08;
            const precutPrep = parseFloat(document.getElementById('f-precut-prep') ? document.getElementById('f-precut-prep').value : 5) || 5;

            // Calculations per printing form count
            const numForms = Math.ceil(numSheets / sheetsPerForm);

            // Precise Plate Calculation for Leaves & Podkarton based on Lice/Hrbet colors
            const isObratLeaves = document.getElementById('calc-is-obrat-leaves') ? document.getElementById('calc-is-obrat-leaves').checked : false;
            const isSVLeaves = document.getElementById('calc-is-sv-leaves') ? document.getElementById('calc-is-sv-leaves').checked : false;
            let platesPerFormLeaves = colorsFrontLeaves + colorsBackLeaves;
            if (isObratLeaves && colorsFrontLeaves === colorsBackLeaves && colorsFrontLeaves > 0) {
                platesPerFormLeaves = colorsFrontLeaves; // 1 forma pri obračanju (4 plošče)
            }
            // Pri ŠV (Šen Vider) sta sprednja in zadnja stran ločeni (8 plošč), tiska pa se v 1 prehodu

            let numPlatesPodkarton = (podkartonType !== 'samo_razrez' && podkartonType !== 'brez') ? totalPodkartonColors : (podkartonColorsFront + podkartonColorsBack);
            const totalPlatesLeaves = (printTech !== 'digital' && printTech !== 'cooperation') ? (numForms * platesPerFormLeaves) : 0;
            const totalPlates = totalPlatesLeaves + numPlatesPodkarton;
            const totalPlatesCost = totalPlates * platePrice;

            let sheetAreaM2 = 0.45 * 0.64;
            if (sheetFormat === '330x488') sheetAreaM2 = 0.33 * 0.488;
            else if (sheetFormat === '500x700') sheetAreaM2 = 0.50 * 0.70;
            else if (sheetFormat === '700x1000') sheetAreaM2 = 0.70 * 1.00;

            const resultsBody = document.getElementById('results-body');
            resultsBody.innerHTML = '';
            const summaryCardsDiv = document.getElementById('summary-cards');
            summaryCardsDiv.innerHTML = '';

            let firstTotalPreview = '';

            quantities.forEach((qty, idx) => {
                const totalPrintSheets = Math.ceil((qty * numSheets / sheetsPerForm) * (1 + wastePercent / 100));

                // Update net sheets displays
                const resLeavesNet = document.getElementById('res-sheets-leaves-net');
                if (resLeavesNet) resLeavesNet.innerText = `${totalPrintSheets} pol`;

                const singleSheetWeightKg = sheetAreaM2 * (paperWeight / 1000);
                const totalLeavesPaperKg = totalPrintSheets * singleSheetWeightKg;
                const totalLeavesPaperCost = totalLeavesPaperKg * paperPriceKg;

                let totalPodkartonCost = 0;
                let podkartonNetSheets = 0;
                if (podkartonType !== 'brez') {
                    podkartonNetSheets = Math.ceil(qty * 1.08);
                    const resCoverNet = document.getElementById('res-sheets-cover-net');
                    if (resCoverNet) resCoverNet.innerText = `${podkartonNetSheets} pol`;

                    const podkartonM2PerUnit = (calWidth / 1000) * (calHeight / 1000);
                    const podkartonGrammage = parseFloat(document.getElementById('podkarton-weight') ? document.getElementById('podkarton-weight').value : 900) || 900;
                    const podkartonWastePct = parseFloat(document.getElementById('podkarton-waste-percent') ? document.getElementById('podkarton-waste-percent').value : 8) || 8;

                    const totalPodkartonKg = (qty * podkartonM2PerUnit * (podkartonGrammage / 1000)) * (1 + podkartonWastePct / 100);
                    const podkartonMaterialCost = totalPodkartonKg * podkartonPriceKg;
                    const cuttingCost = qty * podkartonCutPrice;
                    let kasiranjeCost = 0;
                    if (podkartonType === 'kasiranje') {
                        kasiranjeCost = (qty * podkartonKasiranjePrice) + 15.0; // 15€ prep
                    }
                    totalPodkartonCost = podkartonMaterialCost + cuttingCost + kasiranjeCost;
                }

                if (idx === 0) {
                    const podkKg = (podkartonType !== 'brez' && typeof totalPodkartonKg !== 'undefined') ? totalPodkartonKg : 0;
                    const totalOrderWeightKg = totalLeavesPaperKg + podkKg + (qty * 0.02);
                    window.g_currentTotalWeightKg = totalOrderWeightKg;
                    if (typeof window.syncTariffWeightExternal === "function") window.syncTariffWeightExternal();
                }

                let totalPrintCost = 0;
                if (printTech !== 'digital') {
                    const setupCost = numForms * setupCostPerForm;
                    const passesCount = totalPrintSheets * (isSVLeaves ? 1 : ((printType === '4/4' || printType === '1/1') ? 2 : 1));
                    const runCost = (passesCount / 1000) * 15.0; // 15 € / 1000 passes
                    totalPrintCost = totalPlatesCost + setupCost + runCost;
                } else {
                    const totalClicks = qty * numSheets * ((printType === '4/4' || printType === '1/1') ? 2 : 1);
                    totalPrintCost = (totalClicks * 0.08) + 30.0; // 30 € prep digital
                }

                const totalSheetsToCollate = numSheets + (podkartonType !== 'brez' ? 1 : 0);
                const totalZnasanjeCost = qty * (totalSheetsToCollate * znasanjePerSheet);
                const totalSpiralaCost = qty * (spiralaPriceBase + vesalcekPrice);

                let dodatnaDelaCost = 0;
                if (document.getElementById('f-dodatna-dela-active')?.checked) {
                    let dSheets = parseFloat((document.getElementById('f-dodatna-dela-sheets')?.value || '').replace(',', '.')) || 0;
                    let dKom = parseFloat((document.getElementById('f-dodatna-dela-kom')?.value || '').replace(',', '.')) || 0;
                    let dPrice = parseFloat((document.getElementById('f-dodatna-dela-price')?.value || '').replace(',', '.')) || 0;
                    dodatnaDelaCost = (dSheets + dKom) * dPrice;
                }

                const totalManualCost = (qty * (vezicaPrice + manualLaborPrice + packagingPrice)) + precutPrep + dodatnaDelaCost;

                const deliveryCost = (document.getElementById('f-del-fixed-active')?.checked ? (parseFloat(document.getElementById('f-del-fixed-cost')?.value) || 0) : 0);
      const netProductionCost = totalLeavesPaperCost + totalPodkartonCost + totalPrintCost + totalZnasanjeCost + totalSpiralaCost + totalManualCost + deliveryCost;
                
                const sellingPriceBrezDDV = netProductionCost * (1 + margin / 100);

                const unitPriceBrezDDV_4dec = Math.round((sellingPriceBrezDDV / qty) * 10000) / 10000;
                const exactTotalBrezDDV = Math.round((unitPriceBrezDDV_4dec * qty) * 100) / 100;
                const exactTotalZDDV = Math.round((exactTotalBrezDDV * (1 + ddvPercent / 100)) * 100) / 100;

                if (idx === 0) {
                    firstTotalPreview = `${qty} kos: <strong>${exactTotalBrezDDV.toFixed(2)} €</strong> (${unitPriceBrezDDV_4dec.toFixed(4)} €/kos)`;
                }

                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td class="font-bold">${qty} kos</td>
                    <td class="text-right">${totalLeavesPaperCost.toFixed(2)} €</td>
                    <td class="text-right">${totalPodkartonCost.toFixed(2)} €</td>
                    <td class="text-right">${totalPrintCost.toFixed(2)} €</td>
                    <td class="text-right">${(totalZnasanjeCost + totalSpiralaCost).toFixed(2)} €</td>
                    <td class="text-right">${totalManualCost.toFixed(2)} €</td>
                    <td class="text-right">${netProductionCost.toFixed(2)} €</td>
                    <td class="text-right font-bold text-accent">${unitPriceBrezDDV_4dec.toFixed(4)} €</td>
                    <td class="text-right font-bold">${exactTotalBrezDDV.toFixed(2)} €</td>
                    <td class="text-right">${exactTotalZDDV.toFixed(2)} €</td>
                `;
                resultsBody.appendChild(tr);

                const card = document.createElement('div');
                card.className = `sum-card ${idx === 0 ? 'highlight' : ''}`;
                card.innerHTML = `
                    <div class="label">Ponudba za ${qty} kos</div>
                    <div class="val">${exactTotalBrezDDV.toFixed(2)} €</div>
                    <div style="font-size:0.85rem; color:var(--text-muted); margin-top:4px;">Cena: <strong>${unitPriceBrezDDV_4dec.toFixed(4)} €/kos</strong></div>
                    <div style="font-size:0.78rem; color:var(--text-muted);">z DDV: ${exactTotalZDDV.toFixed(2)} €</div>
                `;
                summaryCardsDiv.appendChild(card);
            });

            document.getElementById('quick-total-display').innerHTML = firstTotalPreview;

            // Visual Canvas Drawing for Listi and Podkarton (Izris stavkov na poli)
            try {
                let sheetW = 700, sheetH = 500;
                if (sheetFormat === 'B1') { sheetW = 1000; sheetH = 700; }
                else if (sheetFormat === 'B3') { sheetW = 500; sheetH = 350; }
                else if (sheetFormat === 'A3') { sheetW = 450; sheetH = 320; }
                else if (sheetFormat === 'A4') { sheetW = 320; sheetH = 225; }

                let layoutLeaves = calculateBestLayout(sheetW, sheetH, calWidth, calHeight, 15, 3);
                let isLeavesManual = sheetsPerForm !== layoutLeaves.count;
                drawCanvas('canvas-leaves', sheetW, sheetH, layoutLeaves, 15, calWidth, calHeight, 3, isLeavesManual, sheetsPerForm);
                if (document.getElementById('res-leaves-yield-info')) {
                    document.getElementById('res-leaves-yield-info').innerText = `${sheetsPerForm} stavkov na poli (${sheetFormat} ${sheetW}x${sheetH} mm, izkoristek ${layoutLeaves.wastePct}%)`;
                }

                // Podkarton Canvas
                let podkartonW = parseFloat(document.getElementById('podkarton-w') ? document.getElementById('podkarton-w').value : calWidth) || calWidth;
                let podkartonH = parseFloat(document.getElementById('podkarton-h') ? document.getElementById('podkarton-h').value : calHeight) || calHeight;
                let podkartonManualSheets = parseInt(document.getElementById('podkarton-sheets-per-form') ? document.getElementById('podkarton-sheets-per-form').value : 1) || 1;
                
                let layoutCover = calculateBestLayout(sheetW, sheetH, podkartonW, podkartonH, 15, 3);
                let isCoverManual = podkartonManualSheets !== layoutCover.count;
                drawCanvas('canvas-cover', sheetW, sheetH, layoutCover, 15, podkartonW, podkartonH, 3, isCoverManual, podkartonManualSheets);
                if (document.getElementById('res-cover-yield-info')) {
                    document.getElementById('res-cover-yield-info').innerText = `${podkartonManualSheets} stavkov na poli (${sheetFormat} ${sheetW}x${sheetH} mm, izkoristek ${layoutCover.wastePct}%)`;
                }

                // Draw Source Sheet Cutting Canvas
                drawSourceLayoutCanvas('canvas-source-leaves', 1000, 700, sheetW, sheetH, '#3b82f6');
                drawSourceLayoutCanvas('canvas-source-cover', 1000, 700, sheetW, sheetH, '#f43f5e');
            } catch (err) {
                console.log('Canvas render error:', err);
            }

        }

