        function parsePdfAndShowDataModal(fullText, filename, detectedW, detectedH) {
            let customer = "";
            let quoteNum = "";
            let dnNum = "";
            let custCode = "";
            let productCode = "";
            let title = "";
            let qty = "";
            let fmtW = "";
            let fmtH = "";
            let deadline = "";
            let packaging = "";

            const text = fullText || '';

            // Matchers
            const matchCust = text.match(/(?:Stranka|Naročnik|Kupac|Naročnik\/Stranka|Firma|Podjetje|Kunde)\s*[:#-]?\s*([^\n\r,]+)/i);
            if (matchCust) customer = matchCust[1].trim();

            const matchQuote = text.match(/(?:Ponudba\s*(?:št\.?|številka)?|PONUDBA\s*ŠT\.?|PON|Angebot)\s*[:#-]?\s*([A-Za-z0-9\/-]+)/i);
            if (matchQuote) quoteNum = matchQuote[1].trim();

            const matchDn = text.match(/(?:D\.?N\.?|Delovni\s*nalog|Naročilo\s*št\.?|Auftrag)\s*[:#-]?\s*([A-Za-z0-9\/-]+)/i);
            if (matchDn) dnNum = matchDn[1].trim();

            const matchCode = text.match(/(?:Šifra\s*stranke|Koda\s*stranke|Šifra\s*kupca|Kundennummer)\s*[:#-]?\s*([A-Za-z0-9\/-]+)/i);
            if (matchCode) custCode = matchCode[1].trim();

            const matchTitle = text.match(/(?:Artikel|Naziv|Izdelek|Zadeva|Predmet|Naziv\s*projekta|Titel)\s*[:#-]?\s*([^\n\r]+)/i);
            if (matchTitle && matchTitle[1].trim().length > 1 && !matchTitle[1].match(/^(Rückseite|Innenseite)$/i)) {
                title = matchTitle[1].trim();
            }
            if (!title && filename) {
                title = filename.replace(/\.pdf$/i, '').replace(/[\(\[\{]\d+[\)\]\}]$/, '').trim();
            }

            const matchQty = text.match(/(?:Količina|Naklada|Količina\s*v\s*kos|Auflage|Menge)\s*[:#-]?\s*([\d\.\s]+)/i) || text.match(/(\d{1,3}(?:\.\d{3})*|\d+)\s*(?:kos|pcs|pol|kosov|Stk|Stück)/i);
            if (matchQty) qty = matchQty[1].replace(/\s+/g, '').trim();

            const matchFmt = text.match(/(\d{2,4})\s*[xX*×]\s*(\d{2,4})\s*(?:mm|cm)?/);
            if (matchFmt) {
                fmtW = matchFmt[1];
                fmtH = matchFmt[2];
            } else if (detectedW && detectedH) {
                fmtW = detectedW;
                fmtH = detectedH;
            } else if (g_attachedPdf && g_attachedPdf.widthMm && g_attachedPdf.heightMm) {
                fmtW = g_attachedPdf.widthMm;
                fmtH = g_attachedPdf.heightMm;
            }

            const matchDl = text.match(/(?:Rok|Rok\s*dobave|Rok\s*izdelave|Datum\s*dobave|Liefertermin)\s*[:#-]?\s*([\d\.\s\/]+)/i);
            if (matchDl) deadline = matchDl[1].trim();

            const matchPkg = text.match(/(?:Pakiranje|Pakirano|Verpackung)\s*[:#-]?\s*([^\n\r]+)/i);
            if (matchPkg) packaging = matchPkg[1].trim();

            let notesText = text ? text.slice(0, 1500) : '';
            if (fmtW && fmtH && !matchFmt) {
                notesText = `[Zaznan format strani PDF: ${fmtW} x ${fmtH} mm]\n` + notesText;
            }

            // Set modal values
            function setField(id, val) {
                const el = document.getElementById(id);
                if (el) el.value = val || '';
            }
            setField('pdf-val-customer', customer);
            setField('pdf-val-project-name', title);
            setField('pdf-val-quote-num', quoteNum);
            setField('pdf-val-dn-num', dnNum);
            setField('pdf-val-cust-code', custCode);
            setField('pdf-val-product-code', productCode);
            setField('pdf-val-qty', qty);
            setField('pdf-val-fmt-w', fmtW);
            setField('pdf-val-fmt-h', fmtH);
            setField('pdf-val-deadline', deadline);
            setField('pdf-val-packaging', packaging);
            setField('pdf-val-notes', notesText.trim());

            const srcFilenameEl = document.getElementById('pdf-data-source-filename');
            if (srcFilenameEl) {
                srcFilenameEl.textContent = filename || (g_attachedPdf ? g_attachedPdf.name : '');
            }

            const modal = document.getElementById('modal-pdf-data-confirm');
            if (modal) {
                modal.style.zIndex = '1000005';
                modal.style.display = 'flex';
            }
        }

