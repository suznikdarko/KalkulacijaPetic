        function searchPaperStock(query) {
            const suggestionsDiv = document.getElementById('paper-suggestions');
            if (!query || query.length < 2 || !stockItems.length) {
                suggestionsDiv.style.display = 'none';
                return;
            }

            const q = query.toLowerCase();
            const matches = stockItems.filter(item => {
                const name = (item.NAZIV || item.naziv || '').toLowerCase();
                return name.includes(q);
            }).slice(0, 10);

            if (matches.length === 0) {
                suggestionsDiv.style.display = 'none';
                return;
            }

            suggestionsDiv.innerHTML = matches.map(item => {
                const name = item.NAZIV || item.naziv || 'Neznan papir';
                const weight = item.GRAMATURA || item.gramatura || 170;
                const priceKg = item.CENA_KG || item.cena_kg || 1.45;
                return `<div class="autocomplete-suggestion" onclick="selectStockPaper('${name.replace(/'/g, "\\'")}', ${weight}, ${priceKg})">
                    <strong>${name}</strong> (${weight}g) - ${priceKg} €/kg
                </div>`;
            }).join('');
            suggestionsDiv.style.display = 'block';
        }

        function selectStockPaper(name, weight, priceKg) {
            document.getElementById('paper-type').value = name;
