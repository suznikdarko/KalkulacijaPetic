        }

        function renderPdfNativeIframe() {
            if (!g_attachedPdf) return;
            const frame = document.getElementById('pdf-viewer-native-frame');
            if (!frame) return;

            if (g_pdfNativeBlobUrl) {
                try { URL.revokeObjectURL(g_pdfNativeBlobUrl); } catch(e){}
                g_pdfNativeBlobUrl = null;
            }

            try {
                let blob = null;
                if (g_attachedPdf.arrayBuffer) {
                    blob = new Blob([g_attachedPdf.arrayBuffer], { type: 'application/pdf' });
                } else if (g_attachedPdf.dataUrl) {
                    const base64 = g_attachedPdf.dataUrl.indexOf(',') >= 0 ? g_attachedPdf.dataUrl.split(',')[1] : g_attachedPdf.dataUrl;
                    const bin = atob(base64);
                    const bytes = new Uint8Array(bin.length);
                    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
                    blob = new Blob([bytes.buffer], { type: 'application/pdf' });
                }
                if (blob) {
                    g_pdfNativeBlobUrl = URL.createObjectURL(blob);
                    frame.src = g_pdfNativeBlobUrl + '#view=FitH';
                }
            } catch (err) {
                console.error("Napaka pri pripravi native PDF pogleda:", err);
                setPdfViewerMode('canvas');
            }
        }

        async function renderPdfDocument() {
            if (!g_attachedPdf) return;
            const scrollContainer = document.getElementById('pdf-viewer-scroll-container');
            const loadingEl = document.getElementById('pdf-viewer-loading');
            const pagesInfoEl = document.getElementById('pdf-viewer-pages-info');
            const zoomLevelEl = document.getElementById('pdf-zoom-level');
            
            if (!scrollContainer) return;

            cancelPdfRenderTasks();

            if (loadingEl) {
                loadingEl.style.display = 'block';
                loadingEl.innerHTML = '⏳ Nalaganje in izrisovanje PDF dokumenta z visoko ostrino...';
            }

            try {
                let dataToLoad = null;
                if (g_attachedPdf.arrayBuffer) {
                    dataToLoad = g_attachedPdf.arrayBuffer.slice(0);
                } else if (g_attachedPdf.dataUrl) {
                    const base64 = g_attachedPdf.dataUrl.indexOf(',') >= 0 ? g_attachedPdf.dataUrl.split(',')[1] : g_attachedPdf.dataUrl;
                    const bin = atob(base64);
                    const bytes = new Uint8Array(bin.length);
                    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
                    g_attachedPdf.arrayBuffer = bytes.buffer;
                    dataToLoad = bytes.buffer.slice(0);
                }

                if (!dataToLoad) {
                    if (loadingEl) loadingEl.innerHTML = '<span style="color:#ef4444;">Ni podatkov za prikaz PDF dokumenta.</span>';
                    return;
                }

                if (!g_currentPdfDoc) {
                    const loadingTask = pdfjsLib.getDocument({ data: dataToLoad });
                    g_currentPdfDoc = await loadingTask.promise;
                }

                const pdf = g_currentPdfDoc;
                const numPages = pdf.numPages;
                if (pagesInfoEl) {
                    pagesInfoEl.textContent = `(${numPages} ${numPages === 1 ? 'stran' : (numPages === 2 ? 'strani' : 'strani')})`;
                }

                // Počisti prejšnje strani, obdrži loadingEl
                const oldPages = scrollContainer.querySelectorAll('.pdf-page-wrapper');
                oldPages.forEach(el => el.remove());

                // Razpoložljiva širina in višina kontejnerja:
                const containerW = Math.max(320, (scrollContainer.clientWidth || window.innerWidth) - 64);
                const containerH = Math.max(300, (scrollContainer.clientHeight || window.innerHeight) - 100);

                for (let pageNum = 1; pageNum <= numPages; pageNum++) {
                    const page = await pdf.getPage(pageNum);
                    const unscaledViewport = page.getViewport({ scale: 1.0 });

                    let scale = 1.0;
                    if (typeof g_pdfZoomScale === 'number') {
                        scale = g_pdfZoomScale;
                    } else if (g_pdfZoomScale === 'page') {
                        // Celotna stran v oknu brez drsenja:
                        scale = Math.min(containerW / unscaledViewport.width, containerH / unscaledViewport.height);
                    } else if (g_pdfZoomScale === 'fit') {
                        // Prilagodi širini kontejnerja:
                        scale = Math.min(3.8, Math.max(0.9, containerW / unscaledViewport.width));
                    } else {
                        // 'readable' ali privzeto:
                        // Zagotavlja udobno širino branja vsaj ~1050px - 1150px!
                        // Za manjše etikete (npr. 100x100mm = 283pt) se poveča na 1050px (scale ~3.7)!
                        // Za A4 (595pt) se poveča na 1050px (scale ~1.76)!
                        const targetW = Math.min(containerW, Math.max(1050, containerW * 0.85));
                        scale = Math.min(4.0, Math.max(1.3, targetW / unscaledViewport.width));
                    }

                    if (zoomLevelEl) zoomLevelEl.textContent = Math.round(scale * 100) + '%';

                    const viewport = page.getViewport({ scale: scale });

                    const wrapper = document.createElement('div');
                    wrapper.className = 'pdf-page-wrapper';
                    wrapper.style.display = 'flex';
                    wrapper.style.flexDirection = 'column';
                    wrapper.style.alignItems = 'center';
                    wrapper.style.margin = '0 auto 28px auto';
                    wrapper.style.maxWidth = '100%';

                    if (numPages > 1) {
                        const pageLabel = document.createElement('div');
                        pageLabel.style.color = '#94a3b8';
                        pageLabel.style.fontSize = '0.82rem';
                        pageLabel.style.marginBottom = '8px';
                        pageLabel.style.fontWeight = '600';
                        pageLabel.textContent = `Stran ${pageNum} od ${numPages}`;
                        wrapper.appendChild(pageLabel);
                    }

                    const canvas = document.createElement('canvas');
                    
                    // Visokoločljivostni Super-sampling (vsaj 2.5x) za kristalno jasnost pisav in skenov:
                    const dpr = Math.max(window.devicePixelRatio || 1, 2.5);
                    const renderViewport = page.getViewport({ scale: scale * dpr });

                    // Resnična ločljivost slikovnega medpomnilnika (visoka ločljivost):
                    canvas.width = Math.round(renderViewport.width);
                    canvas.height = Math.round(renderViewport.height);

                    // Prikazna velikost na zaslonu:
                    const dispW = Math.round(viewport.width);
                    const dispH = Math.round(viewport.height);
                    canvas.style.width = dispW + 'px';
                    canvas.style.height = dispH + 'px';
                    canvas.style.maxWidth = '100%';
                    canvas.style.maxHeight = 'none';
                    canvas.style.boxShadow = '0 15px 35px rgba(0,0,0,0.6)';
                    canvas.style.borderRadius = '6px';
                    canvas.style.background = '#ffffff';
                    canvas.style.display = 'block';

                    const ctx = canvas.getContext('2d', { alpha: false });

                    wrapper.appendChild(canvas);
                    scrollContainer.appendChild(wrapper);

                    const renderTask = page.render({
                        canvasContext: ctx,
                        viewport: renderViewport
                    });
                    g_pdfRenderTasks.push(renderTask);
                    await renderTask.promise;
                }

                if (loadingEl) loadingEl.style.display = 'none';
            } catch (err) {
                if (err && (err.name === 'RenderingCancelledException' || (err.message && err.message.includes('cancelled')))) {
                    return;
                }
                console.error("Napaka pri izrisu PDF:", err);
                if (loadingEl) {
                    loadingEl.style.display = 'block';
                    loadingEl.innerHTML = `<div style="color:#f87171; text-align:center; padding:20px;">
                        <p style="font-weight:bold; margin-bottom:8px;">Napaka pri izrisu PDF dokumenta: ${err.message}</p>
                        <p style="font-size:0.85rem; color:#94a3b8; margin-bottom:12px;">Dokument lahko odprete neposredno v brskalniku ali prenesete na računalnik.</p>
                        <div style="display:flex; justify-content:center; gap:10px;">
                            <button type="button" onclick="setPdfViewerMode('native')" style="background:#2563eb; color:white; border:none; border-radius:6px; padding:8px 16px; font-weight:bold; cursor:pointer;">📄 Vgrajen brskalnik</button>
                            <button type="button" onclick="openPdfInNewTab()" style="background:#4f46e5; color:white; border:none; border-radius:6px; padding:8px 16px; font-weight:bold; cursor:pointer;">↗ V novem zavihku</button>
                            <button type="button" onclick="downloadAttachedPdf()" style="background:#0284c7; color:white; border:none; border-radius:6px; padding:8px 16px; font-weight:bold; cursor:pointer;">💾 Prenesi izvirni PDF</button>
                        </div>
                    </div>`;
                }
            }
        }

        function changePdfZoom(delta) {
            let current = (typeof g_pdfZoomScale === 'number') ? g_pdfZoomScale : 1.5;
            let next = Math.round((current + delta) * 10) / 10;
            if (next < 0.4) next = 0.4;
            if (next > 4.0) next = 4.0;
            g_pdfZoomScale = next;
            renderPdfDocument();
        }

        function setPdfZoomReadable() {
            g_pdfZoomScale = 'readable';
            renderPdfDocument();
        }

        function setPdfZoomFit() {
            g_pdfZoomScale = 'fit';
            renderPdfDocument();
        }

        function setPdfZoomPage() {
            g_pdfZoomScale = 'page';
            renderPdfDocument();
        }

        function setPdfZoom(val) {
            g_pdfZoomScale = val;
            renderPdfDocument();
        }

        function setPdfZoom100() {
            setPdfZoom(1.0);
        }

        function openPdfInNewTab() {
            if (!g_attachedPdf) return;
            try {
                let blob = null;
                if (g_attachedPdf.arrayBuffer) {
                    blob = new Blob([g_attachedPdf.arrayBuffer], { type: 'application/pdf' });
                } else if (g_attachedPdf.dataUrl) {
                    const base64 = g_attachedPdf.dataUrl.indexOf(',') >= 0 ? g_attachedPdf.dataUrl.split(',')[1] : g_attachedPdf.dataUrl;
                    const bin = atob(base64);
                    const bytes = new Uint8Array(bin.length);
                    for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
                    blob = new Blob([bytes.buffer], { type: 'application/pdf' });
                }
                if (blob) {
                    const blobUrl = URL.createObjectURL(blob);
                    let win = null;
                    try {
                        if (window.top && window.top !== window) {
                            win = window.top.open(blobUrl, '_blank');
                        }
                    } catch(e) {}
                    if (!win) {
                        window.open(blobUrl, '_blank');
                    }
                }
            } catch(e) {
                console.error("Napaka pri odpiranju PDF v novem zavihku:", e);
                downloadAttachedPdf();
            }
        }

        function downloadAttachedPdf(index) {
            syncActiveAttachedPdf();
            const target = (typeof index === 'number' && g_attachedPdfs[index]) ? g_attachedPdfs[index] : g_attachedPdf;
            if (!target) return;

            const a = document.createElement('a');
            const fname = target.name || 'Dokument';
            const lname = fname.toLowerCase();

            if (target.dataUrl) {
                a.href = target.dataUrl;
            } else if (target.arrayBuffer) {
                let mime = 'application/octet-stream';
                if (lname.endsWith('.pdf')) mime = 'application/pdf';
                else if (lname.endsWith('.xlsx')) mime = 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet';
                else if (lname.endsWith('.xls')) mime = 'application/vnd.ms-excel';
                else if (lname.endsWith('.docx')) mime = 'application/vnd.openxmlformats-officedocument.wordprocessingml.document';
                else if (lname.endsWith('.doc')) mime = 'application/msword';
                else if (lname.endsWith('.jpg') || lname.endsWith('.jpeg')) mime = 'image/jpeg';
                else if (lname.endsWith('.png')) mime = 'image/png';
                else if (lname.endsWith('.webp')) mime = 'image/webp';

                const blob = new Blob([target.arrayBuffer], { type: mime });
                a.href = URL.createObjectURL(blob);
            }
            a.download = fname;
            document.body.appendChild(a);
            a.click();
            setTimeout(() => { if (a.parentNode) a.parentNode.removeChild(a); }, 300);
        }

        function openDocPreviewModal(index) {
            syncActiveAttachedPdf();
