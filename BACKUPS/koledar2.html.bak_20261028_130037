                    if (elW) { elW.value = fmtW; if (typeof updateInputStyles === 'function') updateInputStyles(elW); }
                }
                if (!isNaN(fmtH) && fmtH > 0) {
                    const elH = document.getElementById('height') || document.getElementById('inp-format-y') || document.getElementById('dim-h');
                    if (elH) { elH.value = fmtH; if (typeof updateInputStyles === 'function') updateInputStyles(elH); }
                }
            }

            closePdfDataModal();
            if (typeof calculate === 'function') calculate();
            else if (typeof calculatePrice === 'function') calculatePrice();
        }

