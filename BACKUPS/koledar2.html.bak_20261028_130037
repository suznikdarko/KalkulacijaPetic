                            <div style="display:flex; align-items:center; gap:8px;">
                                <button type="button" id="doc-preview-dl-btn" style="background:#0284c7; color:white; border:none; border-radius:6px; padding:6px 14px; font-size:0.8rem; font-weight:bold; cursor:pointer; display:flex; align-items:center; gap:6px;">💾 Prenesi / Odpri</button>
                                <button type="button" onclick="document.getElementById('modal-doc-preview').style.display='none'" style="background:#ef4444; color:white; border:none; border-radius:6px; padding:6px 14px; font-size:0.85rem; font-weight:bold; cursor:pointer;">✕ Zapri</button>
                            </div>
