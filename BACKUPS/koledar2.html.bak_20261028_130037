                modal.id = 'modal-doc-preview';
                modal.style.cssText = 'display:none; position:fixed; top:0; left:0; width:100vw; height:100vh; background:rgba(0,0,0,0.8); z-index:1000010; justify-content:center; align-items:center; backdrop-filter:blur(4px);';
                modal.innerHTML = `
                    <div style="background:#0f172a; border:1px solid #334155; border-radius:12px; width:92%; max-width:1100px; height:85vh; display:flex; flex-direction:column; box-shadow:0 25px 50px -12px rgba(0,0,0,0.7); overflow:hidden;">
                        <div style="padding:12px 18px; background:#1e293b; border-bottom:1px solid #334155; display:flex; justify-content:space-between; align-items:center; color:white;">
                            <div style="display:flex; align-items:center; gap:10px;">
                                <span id="doc-preview-icon" style="font-size:1.3rem;">📊</span>
