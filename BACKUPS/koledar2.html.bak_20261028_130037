        function calculateBestLayout(sheetW, sheetH, itemW, itemH, gripper = 15, bleed = 3) {
            let effItemW = itemW + 2 * bleed;
            let effItemH = itemH + 2 * bleed;

            let gridW_H = sheetW;
            let gridH_H = sheetH - gripper;

            let cols1 = Math.floor(gridW_H / effItemW);
            let rows1 = Math.floor(gridH_H / effItemH);
            let count1 = cols1 * rows1;

            let cols2 = Math.floor(gridW_H / effItemH);
            let rows2 = Math.floor(gridH_H / effItemW);
            let count2 = cols2 * rows2;

            if (count1 >= count2 && count1 > 0) {
                let usedArea = count1 * effItemW * effItemH;
                let totalArea = sheetW * sheetH;
                return { count: count1, cols: cols1, rows: rows1, itemW: effItemW, itemH: effItemH, rot: false, gripEdge: 'H', wastePct: ((1 - usedArea / totalArea) * 100).toFixed(1) };
            } else if (count2 > 0) {
                let usedArea = count2 * effItemW * effItemH;
                let totalArea = sheetW * sheetH;
                return { count: count2, cols: cols2, rows: rows2, itemW: effItemH, itemH: effItemW, rot: true, gripEdge: 'H', wastePct: ((1 - usedArea / totalArea) * 100).toFixed(1) };
            }
            return { count: 1, cols: 1, rows: 1, itemW: effItemW, itemH: effItemH, rot: false, gripEdge: 'H', wastePct: 0 };
        }

        function drawCanvas(canvasId, sheetW, sheetH, layout, gripper, origW, origH, bleed, isManualMatch = false, manualTarget = 0) {
            const canvas = document.getElementById(canvasId);
            if (!canvas) return;
            const emptyStateId = (canvasId === 'canvas-leaves') ? 'empty-state-leaves' : 'empty-state-cover';
            const emptyEl = document.getElementById(emptyStateId);
            if (emptyEl) emptyEl.style.display = 'none';

            const ctx = canvas.getContext('2d');
            canvas.style.display = 'block';

            const wrapperId = (canvasId === 'canvas-leaves') ? 'canvas-wrapper-leaves' : 'canvas-wrapper-cover';
            const wrapper = document.getElementById(wrapperId);
            let maxCanvasW = wrapper ? wrapper.clientWidth : 350;
            if (maxCanvasW < 250) maxCanvasW = 350;
            maxCanvasW -= 20;

            const maxCanvasH = 320;
            const scale = Math.min(maxCanvasW / sheetW, maxCanvasH / sheetH) * 0.95;

            const targetW = Math.round(sheetW * scale);
            const targetH = Math.round(sheetH * scale);
            if (canvas.width !== targetW) canvas.width = targetW;
            if (canvas.height !== targetH) canvas.height = targetH;

            // Ozadje
            ctx.fillStyle = '#ffffff';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Rob pole
            ctx.strokeStyle = '#94a3b8';
            ctx.lineWidth = 2;
            ctx.strokeRect(0, 0, canvas.width, canvas.height);

            // Prijemalec
            ctx.fillStyle = 'rgba(239, 68, 68, 0.12)';
            ctx.strokeStyle = 'rgba(239, 68, 68, 0.5)';
            ctx.setLineDash([4, 4]);
            ctx.fillRect(0, canvas.height - (gripper * scale), canvas.width, gripper * scale);
            ctx.beginPath();
            ctx.moveTo(0, canvas.height - (gripper * scale));
            ctx.lineTo(canvas.width, canvas.height - (gripper * scale));
            ctx.stroke();
            ctx.setLineDash([]);

            // Prijemalec tekst
            ctx.save();
            ctx.font = 'bold 11px Inter, sans-serif';
            ctx.fillStyle = '#ef4444';
            ctx.textAlign = 'center';
            ctx.fillText('Prijemalec: ' + gripper + ' mm', canvas.width / 2, canvas.height - 4);
            ctx.restore();

            // Vodni znak števila stavkov
            ctx.save();
            ctx.font = 'bold ' + (canvas.height * 0.28) + 'px Inter, sans-serif';
            ctx.textAlign = 'center';
            ctx.textBaseline = 'middle';
            ctx.fillStyle = isManualMatch ? 'rgba(245, 158, 11, 0.12)' : 'rgba(59, 130, 246, 0.08)';
            let countToDisplay = (manualTarget > 0) ? manualTarget : layout.count;
            ctx.fillText(countToDisplay, canvas.width / 2, canvas.height / 2);
            ctx.restore();

            // Mreža stavkov
            let bestC = layout.cols;
            let bestR = layout.rows;
            if (manualTarget > 0 && manualTarget <= layout.rows * layout.cols) {
                bestC = Math.min(manualTarget, layout.cols);
                bestR = Math.ceil(manualTarget / bestC);
            }

            const gridTotalW = bestC * layout.itemW;
            const gridTotalH = bestR * layout.itemH;

            const usableW = sheetW;
            const usableH = sheetH - gripper;

            const startX = (usableW - gridTotalW) / 2;
            const startY = (usableH - gridTotalH) / 2;

            let drawnCount = 0;
            const maxDraw = (manualTarget > 0) ? manualTarget : layout.count;

            for (let r = 0; r < bestR; r++) {
                for (let c = 0; c < bestC; c++) {
                    if (drawnCount >= maxDraw) break;
                    drawnCount++;

                    const x = (startX + c * layout.itemW) * scale;
                    const y = (startY + r * layout.itemH) * scale;
                    const w = layout.itemW * scale;
                    const h = layout.itemH * scale;

                    // Stavek (Element)
                    ctx.fillStyle = isManualMatch ? 'rgba(251, 191, 36, 0.25)' : 'rgba(59, 130, 246, 0.2)';
                    ctx.fillRect(x, y, w, h);

                    ctx.strokeStyle = isManualMatch ? '#d97706' : '#2563eb';
                    ctx.lineWidth = 1.5;
                    ctx.strokeRect(x, y, w, h);

                    // Bleed linija
                    const bX = bleed * scale;
                    const bY = bleed * scale;
                    const innerW = Math.max(0, w - 2 * bX);
                    const innerH = Math.max(0, h - 2 * bY);
                    ctx.strokeStyle = isManualMatch ? 'rgba(217, 119, 6, 0.4)' : 'rgba(37, 99, 235, 0.4)';
                    ctx.setLineDash([2, 2]);
                    ctx.strokeRect(x + bX, y + bY, innerW, innerH);
                    ctx.setLineDash([]);

                    // Dimenzija stavka
                    ctx.save();
                    ctx.font = (Math.min(w, h) < 30) ? '8px Inter, sans-serif' : '10px Inter, sans-serif';
                    ctx.fillStyle = isManualMatch ? '#92400e' : '#1e40af';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    const labelW = layout.rot ? origH : origW;
                    const labelH = layout.rot ? origW : origH;
                    ctx.fillText(`${labelW}x${labelH}`, x + (w / 2), y + (h / 2));
                    ctx.restore();
                }
            }

            // Dimenzijski napis
            ctx.save();
            ctx.font = 'bold 11px Inter, sans-serif';
            ctx.fillStyle = '#64748b';
            ctx.textAlign = 'right';
            ctx.fillText(sheetW + ' mm', canvas.width - 10, 18);
            ctx.restore();
        }

        function drawSourceLayoutCanvas(canvasId, sw, sh, pw, ph, color) {
            const canvas = document.getElementById(canvasId);
            if (!canvas) return 0;
            canvas.style.display = 'block';
            const ctx = canvas.getContext('2d');

            let sW = sw, sH = sh;
            if (sH > sW) { sW = sh; sH = sw; }

            const padding = 8;
            const availableW = 320;
            const availableH = 100;
            const scale = Math.min(availableW / sW, availableH / sH);

            const targetW = Math.round(sW * scale + 2 * padding);
            const targetH = Math.round(sH * scale + 2 * padding);
            if (canvas.width !== targetW) canvas.width = targetW;
            if (canvas.height !== targetH) canvas.height = targetH;

            ctx.fillStyle = 'rgba(255,255,255,0.05)';
            ctx.fillRect(padding, padding, sW * scale, sH * scale);
            ctx.strokeStyle = 'rgba(255,255,255,0.2)';
            ctx.lineWidth = 1;
            ctx.strokeRect(padding, padding, sW * scale, sH * scale);

            let y1 = Math.floor(sW / pw) * Math.floor(sH / ph);
            let y2 = Math.floor(sW / ph) * Math.floor(sH / pw);

            let yieldCount, drawPW, drawPH;
            if (y1 >= y2) {
                yieldCount = y1; drawPW = pw; drawPH = ph;
            } else {
                yieldCount = y2; drawPW = ph; drawPH = pw;
            }

            if (yieldCount > 0) {
                let cols = Math.floor(sW / drawPW);
                let rows = Math.floor(sH / drawPH);
                let offsetX = (sW - (cols * drawPW)) / 2;
                let offsetY = (sH - (rows * drawPH)) / 2;
                for (let r = 0; r < rows; r++) {
                    for (let c = 0; c < cols; c++) {
                        ctx.fillStyle = color + '33';
                        ctx.strokeStyle = color;
                        ctx.lineWidth = 1;
                        ctx.fillRect(
                            padding + (offsetX + c * drawPW) * scale,
                            padding + (offsetY + r * drawPH) * scale,
                            drawPW * scale,
                            drawPH * scale
                        );
                        ctx.strokeRect(
                            padding + (offsetX + c * drawPW) * scale,
                            padding + (offsetY + r * drawPH) * scale,
                            drawPW * scale,
                            drawPH * scale
                        );
                    }
                }
            }
            return yieldCount;
        }

        
        function onMachineFormatChange() {
            const tech = document.getElementById('print-tech').value;
            const sfSelect = document.getElementById('sheet-format');
            if (sfSelect) {
                if (tech === 'CD' || tech === 'CD UV') {
                    sfSelect.value = 'B1';
                } else if (tech === 'digital') {
                    sfSelect.value = 'A3';
                } else {
                    sfSelect.value = 'B2';
