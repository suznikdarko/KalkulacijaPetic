<!DOCTYPE html>
<html lang="sl">

<head>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kalkulator Koledarjev - Petrič Kalkulacije</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@500;600;700;800;900&display=swap" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    <script src="tarife_prevozov.js?v=2"></script>
    <script src="customer_contacts_seed.js?v=1"></script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <style>
        :root {
            --bg-color: #0f172a;
            --glass-bg: rgba(30, 41, 59, 0.75);
            --glass-border: rgba(255, 255, 255, 0.1);
            --accent-color: #3b82f6;
            --accent-glow: rgba(59, 130, 246, 0.4);
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            --accent-gradient: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 50%, #06b6d4 100%);
        }

        body.light-mode {
            --bg-color: #f1f5f9;
            --glass-bg: rgba(255, 255, 255, 0.9);
            --glass-border: rgba(203, 213, 225, 0.8);
            --accent-color: #2563eb;
            --accent-glow: rgba(37, 99, 235, 0.2);
            --text-main: #0f172a;
            --text-muted: #475569;
            --card-shadow: 0 10px 25px rgba(15, 23, 42, 0.08);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Inter', sans-serif;
        }

        body {
            zoom: 90%;
            background-color: var(--bg-color);
            background-image:
                radial-gradient(at 0% 0%, rgba(59, 130, 246, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(139, 92, 246, 0.15) 0px, transparent 50%);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: flex-start;
            padding: 1rem;
            padding-bottom: 120px;
            overflow-x: hidden;
        }

        .container {
            display: flex;
            flex-direction: column;
            gap: 1.5rem;
            max-width: 1800px;
            width: 100%;
            margin: 0 auto;
        }

        .panel {
            background: var(--glass-bg);
            backdrop-filter: blur(16px);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 1.5rem;
            box-shadow: var(--card-shadow);
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 0.4rem;
        }

        label {
            font-size: 0.82rem;
            color: var(--text-muted);
            font-weight: 600;
            letter-spacing: 0.3px;
        }

        input, select, textarea {
            width: 100%;
            padding: 0.5rem 0.6rem;
            background: #475569;
            border: 1px solid var(--glass-border);
            border-radius: 10px;
            color: #ffffff;
            font-size: 0.85rem;
            transition: all 0.3s ease;
        }

        body.light-mode input, body.light-mode select, body.light-mode textarea {
            background: #ffffff;
            color: #0f172a;
            border-color: #cbd5e1;
        }

        input::placeholder, textarea::placeholder {
            color: #e2e8f0;
            opacity: 1;
        }

        input:focus, select:focus, textarea:focus {
            outline: none;
            border-color: var(--accent-color);
            box-shadow: 0 0 0 3px var(--accent-glow);
        }

        select option {
            background-color: var(--bg-color);
            color: var(--text-main);
        }

        .main-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1.5rem;
        }

        @media (max-width: 1200px) {
            .main-grid {
                grid-template-columns: 1fr;
            }
        }

        .section-title {
            font-family: 'Inter', sans-serif;
            font-size: 1.1rem;
            font-weight: 700;
            margin-bottom: 1.2rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background: linear-gradient(135deg, #60a5fa, #c084fc);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .grid-2 {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }

        .grid-3 {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 1rem;
        }

        @media (max-width: 600px) {
            .grid-2, .grid-3 {
                grid-template-columns: 1fr;
            }
        }

        .sub-card {
            background: rgba(15, 23, 42, 0.3);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 1.1rem;
            margin-bottom: 1rem;
        }

        body.light-mode .sub-card {
            background: rgba(241, 245, 249, 0.6);
        }

        .sub-card-title {
            font-size: 0.92rem;
            font-weight: 700;
            color: #60a5fa;
            margin-bottom: 0.8rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .badge {
            background: rgba(59, 130, 246, 0.2);
            border: 1px solid rgba(59, 130, 246, 0.4);
            color: #60a5fa;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 0.72rem;
            font-weight: 700;
        }

        .results-table-container {
            overflow-x: auto;
            margin-top: 1rem;
        }

        table.calc-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            font-size: 0.84rem;
        }

        table.calc-table th {
            background: rgba(15, 23, 42, 0.8);
            color: var(--text-muted);
            font-weight: 700;
            text-align: left;
            padding: 0.75rem 0.85rem;
            border-bottom: 2px solid var(--glass-border);
            white-space: nowrap;
        }

        body.light-mode table.calc-table th {
            background: #e2e8f0;
            color: #334155;
        }

        table.calc-table td {
            padding: 0.65rem 0.85rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
            white-space: nowrap;
        }

        body.light-mode table.calc-table td {
            border-bottom-color: #cbd5e1;
        }

        table.calc-table tr:hover td {
            background: rgba(59, 130, 246, 0.05);
        }

        .text-right {
            text-align: right;
        }

        .font-bold {
            font-weight: 700;
        }

        .text-accent {
            color: var(--accent-color);
        }

        .summary-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 1rem;
            margin-top: 1.2rem;
        }

        .sum-card {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid var(--glass-border);
            border-radius: 12px;
            padding: 1.25rem;
            text-align: center;
        }

        body.light-mode .sum-card {
            background: #ffffff;
        }

        .sum-card .label {
            font-size: 0.78rem;
            color: var(--text-muted);
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 0.4rem;
        }

        .sum-card .val {
            font-size: 1.4rem;
            font-weight: 800;
            color: var(--text-main);
        }

        .sum-card.highlight {
            background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(139, 92, 246, 0.2));
            border-color: rgba(59, 130, 246, 0.4);
        }

        .sum-card.highlight .val {
            color: #60a5fa;
            font-size: 1.7rem;
        }

        /* Floating Bottom Action Bar */
        .bottom-bar {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: rgba(15, 23, 42, 0.92);
            backdrop-filter: blur(20px);
            border-top: 1px solid var(--glass-border);
            padding: 1rem 2rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
            z-index: 1000;
            box-shadow: 0 -10px 25px rgba(0, 0, 0, 0.5);
        }

        body.light-mode .bottom-bar {
            background: rgba(255, 255, 255, 0.95);
        }

        .action-btns {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            flex-wrap: wrap;
        }

        .btn {
            padding: 0.65rem 1.25rem;
            border-radius: 10px;
            font-size: 0.88rem;
            font-weight: 700;
            cursor: pointer;
            border: none;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-primary {
            background: var(--accent-gradient);
            color: white;
            box-shadow: 0 4px 15px var(--accent-glow);
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px var(--accent-glow);
        }

        .btn-secondary {
            background: #475569;
            color: var(--text-main);
            border: 1px solid var(--glass-border);
        }

        body.light-mode .btn-secondary {
            background: #e2e8f0;
            color: #0f172a;
        }

        .btn-secondary:hover {
            background: #334155;
            transform: translateY(-2px);
        }

        .btn-success {
            background: #10b981;
            color: white;
        }

        .btn-success:hover {
            background: #059669;
            transform: translateY(-2px);
        }

        .btn-purple {
            background: #8b5cf6;
            color: white;
        }

        .btn-purple:hover {
            background: #7c3aed;
            transform: translateY(-2px);
        }

        .autocomplete-suggestions {
            position: absolute;
            top: 100%;
            left: 0;
            right: 0;
            background: #1e293b;
            border: 1px solid var(--glass-border);
            border-radius: 8px;
            max-height: 200px;
            overflow-y: auto;
            z-index: 50;
            display: none;
        }

        .autocomplete-suggestion {
            padding: 8px 12px;
            cursor: pointer;
            font-size: 0.82rem;
        }

        .autocomplete-suggestion:hover {
            background: var(--accent-color);
            color: white;
        }
            #modal-pdf-viewer canvas,
        .pdf-page-wrapper canvas {
            max-height: none !important;
        }
    </style>
</head>

<body>
    <div class="container">
        <!-- HEADER PANEL -->
        <div class="header-panel" style="display: grid; grid-template-columns: repeat(6, 1fr); gap: 1.25rem; background: var(--glass-bg); backdrop-filter: blur(16px); border: 1px solid var(--glass-border); border-radius: 16px; padding: 1.5rem; box-shadow: var(--card-shadow);">
            <!-- ROW 1: IZDELEK & STRANKA & PRIPOMBE -->
            <div class="header-group" style="grid-column: span 3;">
                <label for="calc-project-name">Izdelek</label>
                <div style="display: flex; gap: 0.2rem; position: relative;">
                    <input id="calc-project-name" placeholder="Vnesite izdelek" style="flex: 1;" type="text" value="Stenski koledar A3" />
                    <button id="btn-my-projects" onclick="toggleProjectsDropdown()" style="width: auto; background: #64748b; border: none; border-radius: 8px; color: white; cursor: pointer; padding: 0 10px; font-size: 0.8rem; font-weight: bold;">
                        MOJI PROJEKTI ▼
                    </button>
                    <!-- DROPDOWN ZA PROJEKTE -->
                    <div id="projects-dropdown-list" style="display: none; position: absolute; top: 100%; right: 0; width: 320px; background: #1e293b; border: 2px solid #64748b; border-radius: 12px; max-height: 400px; overflow: hidden; z-index: 2000; margin-top: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.5); flex-direction: column;">
                        <div style="padding: 10px; border-bottom: 2px solid #334155; background: #1e293b;">
                            <input id="project-search-input" oninput="renderSavedProjects()" placeholder="Išči (ime, stranka, šifra)..." style="width: 100%; border-radius: 6px; background: #0f172a; border: 1px solid #475569; color: white;" type="text" />
                        </div>
                        <div id="projects-list-content" style="overflow-y: auto; flex: 1; max-height: 300px; padding: 8px;"></div>
                    </div>
                </div>

                <!-- E-POŠTA STRANKE GUMB IN ZNAČKA -->
                <div style="margin-top: 6px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                    <button type="button" onclick="openEmailModal()" id="btn-open-email-modal"
                        style="background: linear-gradient(135deg, #0284c7, #2563eb); border: none; border-radius: 8px; color: white; padding: 5px 12px; font-weight: bold; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; box-shadow: 0 4px 12px rgba(2,132,199,0.3);"
                        title="Vnos, prilep ali uvoz e-pošte / povpraševanja stranke">
                        ✉️ E-POŠTA STRANKE
                    </button>
                    <div id="attached-email-badge" style="display:none; align-items: center; gap: 6px; background: rgba(2, 132, 199, 0.2); border: 1px solid #0284c7; border-radius: 8px; padding: 4px 10px; font-size: 0.8rem; color: #38bdf8;">
                        <span>✉️ <strong id="attached-email-summary">Mail stranke</strong></span>
                        <button type="button" onclick="openEmailModal()" style="background: #0284c7; color: white; border: none; border-radius: 4px; padding: 2px 8px; cursor: pointer; font-weight: bold; font-size: 0.75rem;" title="Odpri in uredi mail">👁️ Poglej / Uredi</button>
                        <button type="button" onclick="removeAttachedEmail()" style="background: rgba(239, 68, 68, 0.3); color: #f87171; border: 1px solid #ef4444; border-radius: 4px; padding: 2px 6px; cursor: pointer; font-size: 0.75rem;" title="Odstrani e-pošto">✕</button>
                    </div>
                                        <button type="button" onclick="document.getElementById('pdf-file-input').click()"
                        style="background: linear-gradient(135deg, #ec4899, #8b5cf6); border: none; border-radius: 8px; color: white; padding: 5px 12px; font-weight: bold; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; font-size: 0.8rem; box-shadow: 0 4px 12px rgba(236,72,153,0.3);"
                        title="Naložite PDF, Excel (.xlsx, .xls) ali Word (.docx, .doc) dokumente naročila ali razdelilnika">
                        📎 PRIPNI DATOTEKO (PDF / Excel / Word / Slike)
                    </button>
                    <input type="file" id="pdf-file-input" accept=".pdf,.xlsx,.xls,.docx,.doc,.jpg,.jpeg,.png,.webp" multiple style="display:none;" onchange="handlePdfFileUpload(event)">
                    <div id="attached-pdfs-container" style="display:inline-flex; align-items: center; gap: 6px; flex-wrap: wrap;"></div>
                    <div id="attached-pdf-badge" style="display:none;"></div>
                </div>
            </div>
            <div class="header-group" style="grid-column: span 3; position: relative; z-index: 1002; overflow: visible !important;">
                <label for="calc-customer">Stranka</label>
                <div style="display: flex; gap: 0.2rem; position: relative;">
                    <input id="calc-customer" list="customer-list" placeholder="Izberite stranko" style="flex: 1;" type="text" />
                    <button type="button" onclick="toggleCustomerDropdown()"
                        style="width: 35px; background: #3b82f6; border: none; border-radius: 8px; color: white; cursor: pointer;" title="Prikaži seznam strank">▼</button>
                    <div id="cust-dropdown-list"
                        style="display: none; position: absolute; top: 100%; left: 0; right: 0; background: #1e293b; border: 1px solid #3b82f6; border-radius: 8px; max-height: 250px; overflow-y: auto; z-index: 1000; margin-top: 5px;">
                    </div>
                </div>
                <datalist id="customer-list"></datalist>
            </div>

            <div class="header-group" style="grid-column: span 6;">
                <label for="calc-notes">Pripombe / posebnosti</label>
                <textarea id="calc-notes" placeholder="Vnesite pripombe ali posebnosti..." rows="2" style="resize: vertical;"></textarea>
            </div>

            <!-- ROW 2: DETAJLI PONUDBE IN DN -->
            <div class="header-group" style="grid-column: span 2; display: flex; flex-direction: column; gap: 0.75rem;">
                <div>
                    <label for="calc-quote-number">Številka ponudbe</label>
                    <input id="calc-quote-number" placeholder="" type="text" />
                </div>
                <div>
                    <label for="calc-customer-code">Šifra stranke</label>
                    <input id="calc-customer-code" placeholder="" type="text" />
                </div>
                <div>
                    <label for="calc-product-code">Šifra izdelka</label>
                    <input id="calc-product-code" placeholder="" type="text" />
                </div>
            </div>

            <div class="header-group" style="grid-column: span 2; display: flex; flex-direction: column; gap: 0.75rem;">
                <div>
                    <label for="calc-dn-number">Številka D.N.</label>
                    <input id="calc-dn-number" placeholder="" type="text" />
                </div>
                <div>
                    <label for="calc-dn-old">Stari D.N. (za montažo)</label>
                    <input id="calc-dn-old" placeholder="" type="text" />
                </div>
                <div>
                    <label for="calc-dn-deadline">Rok izdelave</label>
                    <input id="calc-dn-deadline" placeholder="" type="text" />
                </div>
                <div>
                    <label for="calc-dn-packaging">Pakiranje (D.N.)</label>
                    <input id="calc-dn-packaging" placeholder="" type="text" />
                </div>
            </div>

            <div class="header-group" style="grid-column: span 2; display: flex; flex-direction: column; gap: 0.75rem;">
                <div>
                    <label for="calc-prepared-by">Ponudbo pripravil</label>
                    <select id="calc-prepared-by">
                        <option value="Darko Sužnik" selected>Darko Sužnik</option>
                        <option value="Sašo Slemenšek">Sašo Slemenšek</option>
                        <option value="Tilen Petrič">Tilen Petrič</option>
                    </select>
                </div>
                <!-- DOKUMENTI PREDOGLEDA / GUMBI -->
                <div style="display: flex; gap: 6px; margin-top: 4px; justify-content: center;">
                    <button class="btn btn-secondary" onclick="exportToWord()" style="padding: 8px 4px; font-size: 0.72rem; flex: 1; text-align: center; border: 1px dashed var(--glass-border);">
                        PONUDBA
                    </button>
                    <button class="btn btn-secondary" onclick="exportToWord()" style="padding: 8px 4px; font-size: 0.72rem; flex: 1; text-align: center; border: 1px dashed var(--glass-border);">
                        PON. AT
                    </button>
                    <button class="btn btn-secondary" onclick="exportToWord()" style="padding: 8px 4px; font-size: 0.72rem; flex: 1; text-align: center; border: 1px dashed var(--glass-border);">
                        D. NALOG
                    </button>
            <button class="btn btn-secondary" type="button" onclick="odpriCenikPDF()" style="padding: 8px 4px; font-size: 0.72rem; flex: 1; text-align: center; border: 1px dashed var(--glass-border); color: #38bdf8;" title="Odpri cenik prevozov (PDF)">
              🚚 PREVOZI
            </button>
                </div>
                <div>
                    <label for="calc-order-type">Tip naročila</label>
                    <select id="calc-order-type">
                        <option value="NOVO" selected>NOVO</option>
                        <option value="NOVO AK-JPG Montaže">NOVO AK-JPG Montaže</option>
                        <option value="Sprememba">Sprememba</option>
                        <option value="Sprememba AK-JPG Montaže">Sprememba AK-JPG Montaže</option>
                        <option value="Ponatis">Ponatis</option>
                        <option value="Ponatis AK-JPG Montaže">Ponatis AK-JPG Montaže</option>
                    </select>
                </div>
                <div style="display:flex; align-items:center; gap: 0.5rem; margin-top: 5px;">
                    <input id="calc-dn-urgent" style="width:auto; height:auto; transform: scale(1.3); cursor: pointer;" type="checkbox" />
                    <label for="calc-dn-urgent" style="color: #ef4444; font-weight: bold; margin:0; cursor: pointer;">NUJNO!</label>
                </div>
            </div>

            <!-- NASLOVI -->
            <div class="header-group" style="grid-column: span 6; display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; background: rgba(15, 23, 42, 0.4); padding: 15px; border-radius: 12px; border: 1px dashed var(--glass-border);">
                <div class="header-group">
                    <label for="calc-cust-address">Naslov stranke</label>
                    <textarea id="calc-cust-address" placeholder="Ulica in kraj" rows="2" style="font-family: Inter, sans-serif; resize: vertical; min-height: 50px;"></textarea>
                </div>
                <div class="header-group">
                    <label for="calc-delivery-address">Naslov za dostavo</label>
                    <textarea id="calc-delivery-address" placeholder="" rows="2" style="font-family: Inter, sans-serif; resize: vertical; min-height: 50px;"></textarea>
                </div>
                <div class="header-group" style="grid-column: span 2; position: relative; z-index: 1001; overflow: visible !important;">
                    <label for="calc-cust-email">E-mail stranke</label>
                    <div style="display: flex; gap: 0.2rem; position: relative;">
                        <input id="calc-cust-email" list="email-list" placeholder="E-mail stranke" style="flex: 1;" type="text" />
                        <button type="button" onclick="toggleEmailDropdown()"
                            style="width: 35px; background: #3b82f6; border: none; border-radius: 8px; color: white; cursor: pointer;" title="Prikaži shranjene e-maile">▼</button>
                        <div id="email-dropdown-list"
                            style="display: none; position: absolute; top: 100%; left: 0; right: 0; background: #1e293b; border: 1px solid #3b82f6; border-radius: 8px; max-height: 200px; overflow-y: auto; z-index: 1000; margin-top: 5px;">
                        </div>
                    </div>
                    <datalist id="email-list"></datalist>
                </div>
            </div>

            <!-- ROW 3: KOLIČINE & MARŽA -->
            <div class="header-group" style="grid-column: span 4;">
                <label for="proj-quantities">Količine (loči z vejico)</label>
                <input type="text" id="proj-quantities" value="" placeholder="" oninput="calculate()" />
            </div>
            <div class="header-group" style="grid-column: span 2;">
                <label for="proj-margin">Raba / Marža (%)</label>
                <input type="number" id="proj-margin" value="" placeholder="" step="1" oninput="calculate()" />
            </div>
        </div>

